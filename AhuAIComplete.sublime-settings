{
    // ------------------------------------------------------------------
    // AhuAIComplete -- inline AI code completion (ghost text)
    // Copy this file to Packages/User/AhuAIComplete.sublime-settings before
    // editing it, so that upgrading the package never overwrites your setup.
    // ------------------------------------------------------------------

    // Master switch. It can also be toggled from the command palette.
    "enabled": true,

    // How long to wait after the last keystroke before requesting (debounce).
    // A larger value saves tokens, a smaller one feels more responsive.
    "debounce_ms": 300,

    // ------------------------------------------------------------------
    // Model service
    //   "openai"      Standard chat/completions API (OpenAI, DeepSeek, Kimi,
    //                 OpenRouter, vLLM, one-api, ... anything compatible)
    //   "openai_fim"  OpenAI-style /completions with a suffix field, i.e. real
    //                 fill-in-the-middle, which gives the best completions
    //                 (e.g. DeepSeek beta)
    //   "ollama"      Local Ollama, /api/generate, supports suffix for FIM
    // ------------------------------------------------------------------
    "provider": "ollama",

    "providers": {
        "openai": {
            "base_url": "https://api.openai.com/v1",
            "api_key": "",
            "model": "gpt-4o-mini",
            "max_tokens": 256,
            "temperature": 0.2
        },
        "openai_fim": {
            // Example: the DeepSeek fill-in-the-middle endpoint.
            "base_url": "https://api.deepseek.com/beta",
            "api_key": "",
            "model": "deepseek-chat",
            // Most FIM endpoints (e.g. DeepSeek /beta) only support a single
            // completion, so n=1 is sent by default. To get several candidates,
            // set n explicitly here, for example "n": 3. It wins over the
            // global num_suggestions setting below.
            "max_tokens": 256,
            "temperature": 0.2
        },
        "ollama": {
            "base_url": "http://127.0.0.1:11434",
            "api_key": "",
            // For completion work prefer the coder base models; they were
            // trained for FIM. Switch to qwen2.5-coder:7b if your machine can
            // handle it, for noticeably better quality.
            "model": "qwen2.5-coder:1.5b",
            "max_tokens": 256,
            "temperature": 0.2
        }
    },

    // Request timeout, in seconds
    "timeout": 20,

    // HTTPS certificate verification. Set to false temporarily if a
    // self-signed certificate causes errors.
    "verify_ssl": true,

    // ------------------------------------------------------------------
    // Context
    // ------------------------------------------------------------------

    // How many characters before / after the cursor reach the model
    "prefix_chars": 3000,
    "suffix_chars": 1000,

    // Include the beginning of other files open in the same window, so the
    // model picks up the project's style
    "use_open_files_context": true,
    "open_files_max": 3,
    "open_files_chars": 600,

    // ------------------------------------------------------------------
    // Output
    // ------------------------------------------------------------------

    // Maximum number of lines per suggestion; anything beyond is truncated
    "max_lines": 12,

    // How many candidates to request (cycle them with Cmd+Shift+[ / ]).
    //   ollama      -- parallel requests produce several continuations; the
    //                  count comes from here.
    //   openai      -- uses the API's own n parameter, defaulting to this
    //                  value (raise it to get more candidates).
    //   openai_fim  -- most FIM endpoints (e.g. DeepSeek /beta) only accept
    //                  n=1, so 1 is sent by default; set providers.X.n
    //                  explicitly to ask for more.
    // Cycling only works when more than one candidate is available. Running 3
    // with a local 1.5b model is cheap.
    "num_suggestions": 3,

    // Fine-tune the ghost text font size, in px. On Windows, 1 or 2 helps if
    // it still looks too small; 0 uses the platform DPI conversion only, with
    // no extra adjustment.
    "ghost_font_size_delta": 0,

    // Hide ghost text while the autocomplete popup is open, so the two UIs do
    // not fight each other
    "hide_when_autocomplete_visible": true,

    // Only trigger when the cursor is at the end of a line or followed by
    // nothing but whitespace / closing brackets, to avoid useless requests
    "trigger_only_at_line_end": true,

    // Do not trigger inside these scopes (prefix match)
    "disabled_scopes": [
        "text.plain",
        "text.find-in-files",
        "source.regexp"
    ],

    // Do not trigger in these syntaxes; use a keyword from the syntax file
    // name, matched in lower case
    "disabled_syntaxes": [],

    // Show the current AhuAIComplete state in the status bar
    "show_status": true,

    // Enable debug logging (written to the Sublime console, ctrl+`)
    "debug": false
}
